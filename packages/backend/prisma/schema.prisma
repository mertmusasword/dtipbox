// ======================
// D-TIPBOX Prisma Schema
// ======================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== ENUMS ====================

enum Role {
  ADMIN
  BUSINESS
  EMPLOYEE
  CUSTOMER
}

enum AgreementStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AgreementType {
  MERCHANT_TERMS
  PRIVACY_POLICY
  KVKK_DISCLOSURE
}

enum QrType {
  DTIPBOX
  BANK_PAYMENT
}

enum PaymentMethodType {
  IBAN_TRANSFER
  CARD
  APPLE_PAY
  GOOGLE_PAY
}

enum PaymentMethodStatus {
  ACTIVE
  INACTIVE
}

enum PaymentIntegrationStatus {
  NOT_CONNECTED
  CONNECTED
  ERROR
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  UNVERIFIED
}

enum ProviderType {
  CARD
  VIRTUAL_POS
  BANK_TRANSFER
  WALLET
  OTHER
}

enum ProviderCatalogStatus {
  ACTIVE
  INACTIVE
  DEVELOPMENT
  COMING_SOON
}

enum ProviderRequestStatus {
  PENDING
  REVIEWED
  PLANNED
  REJECTED
}

enum CorporateApplicationStatus {
  NEW
  CONTACTED
  IN_DISCUSSION
  COMPLETED
  REJECTED
}

enum PartnerApplicationStatus {
  NEW
  REVIEWING
  CONTACTED
  INTEGRATION_DISCUSSION
  COMPLETED
  REJECTED
}

enum SupportTicketStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum SupportTicketCategory {
  POS_INTEGRATION
  ACCOUNT_BILLING
  TECHNICAL_SUPPORT
  GENERAL_INQUIRY
  FEEDBACK_SUGGESTION
}

enum TipDistributionMode {
  INDIVIDUAL
  EQUAL_POOL
  POINT_POOL
}

enum PosFeePayer {
  STAFF
  BUSINESS
  CUSTOMER
}

// ==================== MODELS ====================

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  password_hash String
  role          Role     @default(BUSINESS)
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  // Relations
  business              Business?
  employee              Employee?
  audit_logs            AuditLog[]
  agreement_acceptances AgreementAcceptance[]
  password_reset_tokens PasswordResetToken[]
  loyalty_transactions  LoyaltyStampTransaction[]

  @@index([email])
  @@index([role])
  @@map("users")
}

model Business {
  id            String  @id @default(uuid())
  owner_user_id String  @unique
  name          String
  logo          String?
  country       String  // ISO 3166-1 alpha-2
  currency      String  // ISO 4217
  timezone      String  // IANA timezone
  locale        String? // BCP 47 locale tag
  phone         String?
  email         String?
  address       String?
  description   String?
  is_active     Boolean @default(true)

  // Tip Distribution & Pool Settings
  tip_distribution_mode   TipDistributionMode   @default(INDIVIDUAL)
  pos_fee_payer           PosFeePayer           @default(STAFF)
  custom_pos_fee_rate     Decimal?              @default(0.00) @db.Decimal(5, 2)
  tax_deduction_enabled   Boolean               @default(false)
  tax_deduction_rate      Decimal?              @default(0.00) @db.Decimal(5, 2)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations
  owner                   User                   @relation(fields: [owner_user_id], references: [id])
  payment_account         BusinessPaymentAccount?
  employees               Employee[]
  tables                  Table[]
  qr_codes                QrCode[]
  payment_methods         PaymentMethod[]
  payment_integrations    PaymentIntegration[]
  provider_requests       PaymentProviderRequest[]
  tips                    Tip[]
  feedbacks               Feedback[]
  audit_logs              AuditLog[]
  agreement_acceptances   AgreementAcceptance[]
  tip_pool_distributions  TipPoolDistribution[]
  loyalty_programs        LoyaltyProgram[]
  loyalty_cards           LoyaltyCard[]
  loyalty_transactions    LoyaltyStampTransaction[]
  loyalty_redemptions     LoyaltyRedemption[]

  @@index([owner_user_id])
  @@index([country])
  @@map("businesses")
}

model BusinessPaymentAccount {
  id                  String  @id @default(uuid())
  business_id         String  @unique
  country             String
  account_holder_name String
  iban                String?
  account_number      String?
  routing_number      String?
  sort_code           String?
  swift_bic           String?
  bank_name           String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations
  business Business @relation(fields: [business_id], references: [id], onDelete: Cascade)

  @@map("business_payment_accounts")
}

model Employee {
  id          String    @id @default(uuid())
  business_id String
  user_id     String?   @unique
  first_name  String
  last_name   String
  position    String?
  role_title  String?   // e.g. Garson, Komi, Barmen, Aşçı
  share_weight Decimal  @default(1.00) @db.Decimal(4, 2)
  avatar      String?
  is_active   Boolean   @default(true)

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  // Relations
  business              Business                  @relation(fields: [business_id], references: [id], onDelete: Cascade)
  user                  User?                     @relation(fields: [user_id], references: [id])
  tips                  Tip[]
  feedbacks             Feedback[]
  tip_pool_shares       TipPoolShare[]
  loyalty_transactions  LoyaltyStampTransaction[]
  loyalty_redemptions   LoyaltyRedemption[]

  @@index([business_id])
  @@index([user_id])
  @@map("employees")
}

model Table {
  id          String  @id @default(uuid())
  business_id String
  name        String
  is_active   Boolean @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations
  business Business @relation(fields: [business_id], references: [id], onDelete: Cascade)
  qr_codes QrCode[]
  tips     Tip[]

  @@index([business_id])
  @@map("tables")
}

model QrCode {
  id           String  @id @default(uuid())
  business_id  String
  table_id     String?
  type         QrType  @default(DTIPBOX)
  public_token String  @unique
  is_active    Boolean @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations
  business Business @relation(fields: [business_id], references: [id], onDelete: Cascade)
  table    Table?   @relation(fields: [table_id], references: [id], onDelete: SetNull)

  @@index([business_id])
  @@index([public_token])
  @@map("qr_codes")
}

model PaymentMethod {
  id            String              @id @default(uuid())
  business_id   String
  type          PaymentMethodType
  provider      String?
  status        PaymentMethodStatus @default(INACTIVE)
  configuration Json?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations
  business Business @relation(fields: [business_id], references: [id], onDelete: Cascade)

  @@unique([business_id, type])
  @@index([business_id])
  @@map("payment_methods")
}

model PaymentProvider {
  id                   String                @id // e.g. 'stripe', 'square', 'iyzico'
  name                 String                // Canonical lowercase identifier
  display_name         String
  description          String?
  logo_url             String?
  type                 ProviderType          @default(CARD)
  status               ProviderCatalogStatus @default(COMING_SOON)
  countries            String[]              // ISO 3166-1 alpha-2 or ['*'] for global
  supported_currencies String[]              // ISO 4217 currency codes
  capabilities         String[]              // CREATE_PAYMENT, PAYMENT_STATUS, TEST_CONNECTION, REFUND, WEBHOOK
  required_credentials Json                  // Field schema: key, label, type, required, placeholder, description
  has_adapter          Boolean               @default(false)
  is_global            Boolean               @default(false)

  created_at           DateTime              @default(now())
  updated_at           DateTime              @updatedAt

  @@map("payment_providers")
}

model PaymentIntegration {
  id                    String                   @id @default(uuid())
  business_id           String
  provider              String
  status                PaymentIntegrationStatus @default(NOT_CONNECTED)
  configuration         Json?
  credentials_encrypted String?                  @db.Text
  last_tested_at        DateTime?
  last_error_message    String?

  created_at            DateTime                 @default(now())
  updated_at            DateTime                 @updatedAt

  // Relations
  business              Business                 @relation(fields: [business_id], references: [id], onDelete: Cascade)

  @@unique([business_id, provider])
  @@index([business_id])
  @@index([provider])
  @@map("payment_integrations")
}

model PaymentProviderRequest {
  id            String                @id @default(uuid())
  business_id   String
  provider_name String
  country       String
  website       String?
  payment_type  String
  description   String?
  status        ProviderRequestStatus @default(PENDING)

  created_at    DateTime              @default(now())
  updated_at    DateTime              @updatedAt

  // Relations
  business      Business              @relation(fields: [business_id], references: [id], onDelete: Cascade)

  @@index([business_id])
  @@index([status])
  @@map("payment_provider_requests")
}

model Tip {
  id                      String        @id @default(uuid())
  business_id             String
  employee_id             String?
  table_id                String?
  amount                  Decimal       @db.Decimal(10, 2)
  currency                String        // ISO 4217
  payment_method          String
  payment_status          PaymentStatus @default(PENDING)
  provider_transaction_id String?
  customer_name           String?
  customer_message        String?

  // Pool distribution settlement tracking
  is_settled                 Boolean       @default(false)
  tip_pool_distribution_id   String?

  created_at DateTime @default(now())

  // Relations
  business                Business              @relation(fields: [business_id], references: [id], onDelete: Cascade)
  employee                Employee?             @relation(fields: [employee_id], references: [id], onDelete: SetNull)
  table                   Table?                @relation(fields: [table_id], references: [id], onDelete: SetNull)
  feedback                Feedback?
  tip_pool_distribution   TipPoolDistribution?  @relation(fields: [tip_pool_distribution_id], references: [id], onDelete: SetNull)

  @@index([business_id])
  @@index([employee_id])
  @@index([table_id])
  @@index([created_at])
  @@index([payment_status])
  @@index([is_settled])
  @@index([tip_pool_distribution_id])
  @@map("tips")
}

model AuditLog {
  id            String  @id @default(uuid())
  actor_user_id String?
  business_id   String?
  action        String
  entity_type   String
  entity_id     String?
  metadata      Json?

  created_at DateTime @default(now())

  // Relations
  actor    User?     @relation(fields: [actor_user_id], references: [id], onDelete: SetNull)
  business Business? @relation(fields: [business_id], references: [id], onDelete: SetNull)

  @@index([business_id])
  @@index([actor_user_id])
  @@index([created_at])
  @@index([entity_type])
  @@map("audit_logs")
}

model Agreement {
  id          String        @id @default(uuid())
  code        String        @unique // e.g. "MERCHANT_SERVICE_AGREEMENT"
  name        String
  type        AgreementType @default(MERCHANT_TERMS)
  description String?
  is_active   Boolean       @default(true)
  created_at  DateTime      @default(now())
  updated_at  DateTime      @updatedAt

  versions    AgreementVersion[]

  @@map("agreements")
}

model AgreementVersion {
  id                    String          @id @default(uuid())
  agreement_id          String
  version               String          // e.g. "1.0.0"
  title                 String
  content_markdown      String          @db.Text
  content_hash          String          // SHA-256 hash of content_markdown
  status                AgreementStatus @default(DRAFT)
  requires_reacceptance Boolean         @default(true)
  effective_date        DateTime        @default(now())
  published_at          DateTime?
  created_by_user_id    String?
  created_at            DateTime        @default(now())

  agreement             Agreement       @relation(fields: [agreement_id], references: [id], onDelete: Cascade)
  acceptances           AgreementAcceptance[]

  @@unique([agreement_id, version])
  @@index([status])
  @@map("agreement_versions")
}

model AgreementAcceptance {
  id                   String           @id @default(uuid())
  business_id          String
  user_id              String
  agreement_version_id String
  accepted_at          DateTime         @default(now())
  ip_address           String
  user_agent           String           @db.Text
  content_hash         String           // SHA-256 hash at time of acceptance
  snapshot_html        String?          @db.Text
  statement            String           // e.g. "Okudum ve Naponi İşletme Hizmet ve Kullanım Sözleşmesi'ni kabul ediyorum."
  metadata             Json?

  business             Business         @relation(fields: [business_id], references: [id], onDelete: Cascade)
  user                 User             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  version              AgreementVersion @relation(fields: [agreement_version_id], references: [id], onDelete: Restrict)

  @@unique([business_id, agreement_version_id])
  @@index([business_id])
  @@index([agreement_version_id])
  @@index([accepted_at])
  @@map("agreement_acceptances")
}

model CorporateApplication {
  id           String                     @id @default(uuid())
  company_name String
  contact_name String
  phone        String
  email        String
  sector       String
  branch_count String
  message      String?                    @db.Text
  status       CorporateApplicationStatus @default(NEW)
  admin_notes  String?                    @db.Text
  ip_address   String?

  created_at   DateTime                   @default(now())
  updated_at   DateTime                   @updatedAt

  @@index([status])
  @@index([created_at])
  @@map("corporate_applications")
}

model PartnerApplication {
  id               String                   @id @default(uuid())
  company_name     String
  website          String?
  contact_name     String
  email            String
  phone            String?
  company_type     String
  customer_count   String?
  countries        String?
  integration_idea String?                  @db.Text
  message          String?                  @db.Text
  status           PartnerApplicationStatus @default(NEW)
  admin_notes      String?                  @db.Text
  ip_address       String?

  created_at       DateTime                 @default(now())
  updated_at       DateTime                 @updatedAt

  @@index([status])
  @@index([company_type])
  @@index([created_at])
  @@index([email])
  @@map("partner_applications")
}

model SupportTicket {
  id            String                @id @default(uuid())
  user_id       String?
  business_id   String?
  name          String
  email         String
  phone         String?
  business_name String?
  category      SupportTicketCategory @default(GENERAL_INQUIRY)
  subject       String
  message       String                @db.Text
  status        SupportTicketStatus   @default(NEW)
  admin_notes   String?               @db.Text
  ip_address    String?

  created_at    DateTime              @default(now())
  updated_at    DateTime              @updatedAt

  @@index([status])
  @@index([category])
  @@index([created_at])
  @@index([email])
  @@index([user_id])
  @@index([business_id])
  @@map("support_tickets")
}

model Feedback {
  id          String    @id @default(uuid())
  business_id String
  employee_id String?
  tip_id      String?   @unique
  rating      Int
  comment     String?
  created_at  DateTime  @default(now())

  // Relations
  business    Business  @relation(fields: [business_id], references: [id], onDelete: Cascade)
  employee    Employee? @relation(fields: [employee_id], references: [id], onDelete: SetNull)
  tip         Tip?      @relation(fields: [tip_id], references: [id], onDelete: SetNull)

  @@index([business_id])
  @@index([employee_id])
  @@index([created_at])
  @@index([rating])
  @@map("feedbacks")
}

model PasswordResetToken {
  id         String    @id @default(uuid())
  user_id    String
  token_hash String    @unique
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime  @default(now())

  // Relations
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([token_hash])
  @@map("password_reset_tokens")
}

model TipPoolDistribution {
  id                     String         @id @default(uuid())
  business_id            String
  period_start           DateTime
  period_end             DateTime
  gross_amount           Decimal        @db.Decimal(12, 2)
  cash_amount            Decimal        @default(0.00) @db.Decimal(12, 2)
  external_pos_amount    Decimal        @default(0.00) @db.Decimal(12, 2)
  pos_fee_amount         Decimal        @default(0.00) @db.Decimal(12, 2)
  tax_fee_amount         Decimal        @default(0.00) @db.Decimal(12, 2)
  net_distributed_amount Decimal        @db.Decimal(12, 2)
  notes                  String?
  created_at             DateTime       @default(now())

  business               Business       @relation(fields: [business_id], references: [id], onDelete: Cascade)
  shares                 TipPoolShare[]
  tips                   Tip[]

  @@index([business_id])
  @@map("tip_pool_distributions")
}

model TipPoolShare {
  id              String               @id @default(uuid())
  distribution_id String
  employee_id     String
  share_weight    Decimal              @db.Decimal(4, 2)
  gross_share     Decimal              @db.Decimal(12, 2)
  net_share       Decimal              @db.Decimal(12, 2)
  cash_share      Decimal              @default(0.00) @db.Decimal(12, 2)
  digital_share   Decimal              @default(0.00) @db.Decimal(12, 2)
  is_paid         Boolean              @default(false)
  paid_at         DateTime?

  distribution    TipPoolDistribution @relation(fields: [distribution_id], references: [id], onDelete: Cascade)
  employee        Employee             @relation(fields: [employee_id], references: [id], onDelete: Cascade)

  @@index([distribution_id])
  @@index([employee_id])
  @@map("tip_pool_shares")
}

// ==================== LOYALTY (SADAKAT) SYSTEM ====================

model LoyaltyProgram {
  id                 String   @id @default(uuid())
  business_id        String
  name               String   // e.g. "Coffee Loyalty", "Kahve Sadakat Programı"
  target_stamps      Int      @default(10)
  reward_description String   // e.g. "1 Ücretsiz Kahve"
  is_active          Boolean  @default(true)

  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  // Relations
  business           Business                  @relation(fields: [business_id], references: [id], onDelete: Cascade)
  cards              LoyaltyCard[]
  transactions       LoyaltyStampTransaction[]
  redemptions        LoyaltyRedemption[]

  @@index([business_id])
  @@index([is_active])
  @@map("loyalty_programs")
}

model LoyaltyCard {
  id                   String   @id @default(uuid())
  public_id            String   @unique // e.g. c_a9b8c7d6e5f41234
  business_id          String
  program_id           String
  customer_email       String
  customer_name        String?
  card_code            String   @unique // 6-8 chars uppercase e.g. "8F42K7"
  current_stamps       Int      @default(0)
  target_stamps        Int      @default(10)
  total_rewards_earned Int      @default(0)
  is_active            Boolean  @default(true)

  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  // Relations
  business             Business                  @relation(fields: [business_id], references: [id], onDelete: Cascade)
  program              LoyaltyProgram            @relation(fields: [program_id], references: [id], onDelete: Cascade)
  transactions         LoyaltyStampTransaction[]
  redemptions          LoyaltyRedemption[]
  scan_tokens          LoyaltyScanToken[]

  @@unique([business_id, program_id, customer_email])
  @@index([business_id])
  @@index([program_id])
  @@index([customer_email])
  @@index([card_code])
  @@index([public_id])
  @@map("loyalty_cards")
}

model LoyaltyScanToken {
  id         String    @id @default(uuid())
  card_id    String
  token      String    @unique
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime  @default(now())

  // Relations
  card       LoyaltyCard @relation(fields: [card_id], references: [id], onDelete: Cascade)

  @@index([card_id])
  @@index([token])
  @@index([expires_at])
  @@map("loyalty_scan_tokens")
}

model LoyaltyStampTransaction {
  id              String   @id @default(uuid())
  card_id         String
  business_id     String
  program_id      String
  employee_id     String?
  user_id         String?  // Actor user id (staff or business owner)
  action_type     String   // STAMP_ADDED, REWARD_EARNED, REWARD_REDEEMED, STAMPS_RESET
  method          String   // QR, CODE, MANUAL
  previous_stamps Int
  new_stamps      Int
  notes           String?
  scan_token_id   String?

  created_at      DateTime @default(now())

  // Relations
  card            LoyaltyCard    @relation(fields: [card_id], references: [id], onDelete: Cascade)
  business        Business       @relation(fields: [business_id], references: [id], onDelete: Cascade)
  program         LoyaltyProgram @relation(fields: [program_id], references: [id], onDelete: Cascade)
  employee        Employee?      @relation(fields: [employee_id], references: [id], onDelete: SetNull)
  actor           User?          @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([card_id])
  @@index([business_id])
  @@index([program_id])
  @@index([employee_id])
  @@index([created_at])
  @@map("loyalty_stamp_transactions")
}

model LoyaltyRedemption {
  id           String    @id @default(uuid())
  card_id      String
  business_id  String
  program_id   String
  employee_id  String?
  reward_title String
  code         String    @unique // Verification redemption code e.g. RDW-74921
  status       String    @default("PENDING") // PENDING, REDEEMED, EXPIRED
  redeemed_at  DateTime?
  created_at   DateTime  @default(now())

  // Relations
  card         LoyaltyCard    @relation(fields: [card_id], references: [id], onDelete: Cascade)
  business     Business       @relation(fields: [business_id], references: [id], onDelete: Cascade)
  program      LoyaltyProgram @relation(fields: [program_id], references: [id], onDelete: Cascade)
  employee     Employee?      @relation(fields: [employee_id], references: [id], onDelete: SetNull)

  @@index([card_id])
  @@index([business_id])
  @@index([code])
  @@index([status])
  @@map("loyalty_redemptions")
}



