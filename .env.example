# ==============================================================================
# D-TIPBOX — Production Environment Configuration Template
# ==============================================================================
# DO NOT COMMIT REAL SECRETS TO THE REPOSITORY!
# For local development: copy this file to .env and adjust values as needed.
# For Railway deployment: configure these under your Railway Project -> Service -> Variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database (PostgreSQL)
# ------------------------------------------------------------------------------
# On Railway: This is automatically injected when adding the Railway PostgreSQL service.
# Local Dev: postgresql://dtipbox:dtipbox_dev@localhost:5432/dtipbox?schema=public
# Production Example: postgresql://postgres:mypassword@roundhouse.proxy.rlwy.net:5432/railway
DATABASE_URL="postgresql://dtipbox:dtipbox_dev@localhost:5432/dtipbox?schema=public"

# ------------------------------------------------------------------------------
# 2. Server & Runtime Environment
# ------------------------------------------------------------------------------
# On Railway: PORT is dynamically assigned by Railway (do not hardcode in production).
PORT=3000
NODE_ENV=production

# Public application base URL (e.g., https://dtipbox.up.railway.app or https://yourdomain.com)
APP_URL=https://dtipbox.up.railway.app
API_URL=https://dtipbox.up.railway.app

# ------------------------------------------------------------------------------
# 3. Authentication & Cryptography
# ------------------------------------------------------------------------------
# REQUIRED IN PRODUCTION: Set strong, unique, 256-bit random secrets.
# Generate via: openssl rand -hex 32   OR   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_64_char_hex_random_secret_string
JWT_REFRESH_SECRET=replace_with_another_64_char_hex_random_secret_string
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ------------------------------------------------------------------------------
# 4. Platform Initial Admin Bootstrap
# ------------------------------------------------------------------------------
# Used to bootstrap the first superadmin account if no ADMIN user exists on first startup.
ADMIN_EMAIL=admin@dtipbox.com
ADMIN_PASSWORD=ReplaceWithStrongPassword123!

# ------------------------------------------------------------------------------
# 5. CORS & Origin Policies
# ------------------------------------------------------------------------------
# In unified Docker mode (frontend + backend on same domain), requests to /api are same-origin.
# For custom frontends or multiple domains, specify comma-separated origins:
# Example: https://dtipbox.up.railway.app,https://admin.yourdomain.com
CORS_ORIGIN=https://dtipbox.up.railway.app

# ------------------------------------------------------------------------------
# 6. Rate Limiting
# ------------------------------------------------------------------------------
# Window in milliseconds (900000 = 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
# Max requests per IP per window for general API
RATE_LIMIT_MAX=100

# ------------------------------------------------------------------------------
# 7. Payment Providers (Optional / Configure per Business)
# ------------------------------------------------------------------------------
# Stripe (Platform or Connect)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 8. Web Analytics (Google Analytics 4)
# ------------------------------------------------------------------------------
# Format: G-XXXXXXXXXX (Set in Railway or hosting provider for production)
VITE_GA_MEASUREMENT_ID=

